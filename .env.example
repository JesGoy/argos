# Database
DATABASE_URL=postgresql://user:password@host/argos_db

# Auth
JWT_SECRET=your-secret-key-min-32-chars-change-this-in-production

# AI - OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# DTE (SII) — encrypts DteConfig.apiKeyEncrypted at rest
DTE_ENCRYPTION_KEY=your-secret-key-min-32-chars-change-this-in-production
# Authorizes Vercel Cron to call /api/cron/retry-dtes (sent as `Authorization: Bearer <value>`)
CRON_SECRET=your-cron-secret-change-this-in-production

# Environment
NODE_ENV=development
